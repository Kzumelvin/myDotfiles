#!/usr/bin/env bash
#
# dotfiles-sync - aktualisiert das Dotfiles-Repository und spielt es via GNU Stow ein.
#
# Aufruf:
#   dotfiles-sync              # aktualisieren und stowen
#   dotfiles-sync --no-pull    # nur stowen (kein git fetch/pull)
#   dotfiles-sync --dry-run    # nur anzeigen, was passieren würde
#   dotfiles-sync --quiet      # nur Warnungen und Fehler ausgeben
#
# Umgebungsvariablen:
#   DOTFILES_DIR       Pfad zum Repository (Default: ~/myDotfiles)
#   DOTFILES_TARGET    Stow-Target (Default: $HOME)
#   DOTFILES_PACKAGES  Leerzeichen-getrennte Paketliste (Default: automatisch erkannt)

set -uo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/myDotfiles}"
DOTFILES_TARGET="${DOTFILES_TARGET:-$HOME}"

do_pull=1
dry_run=0
quiet=0

while (($#)); do
  case "$1" in
    --no-pull) do_pull=0 ;;
    --dry-run) dry_run=1 ;;
    --quiet|-q) quiet=1 ;;
    -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
    *) printf 'dotfiles-sync: unbekannte Option: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

log()  { ((quiet)) || printf '[dotfiles-sync] %s\n' "$*"; }
warn() { printf '[dotfiles-sync] WARN: %s\n' "$*" >&2; }
err()  { printf '[dotfiles-sync] FEHLER: %s\n' "$*" >&2; }

for cmd in git stow; do
  command -v "$cmd" >/dev/null 2>&1 || { err "'$cmd' ist nicht installiert."; exit 1; }
done

[[ -d "$DOTFILES_DIR/.git" ]] || { err "$DOTFILES_DIR ist kein Git-Repository."; exit 1; }
cd "$DOTFILES_DIR" || exit 1

# --- Repository aktualisieren -------------------------------------------------

if ((do_pull)); then
  if [[ -n "$(git status --porcelain)" ]]; then
    warn "Lokale Änderungen vorhanden - Update wird übersprungen, es wird nur gestowt."
  else
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
    if [[ -z "$branch" ]]; then
      warn "HEAD ist detached - Update wird übersprungen."
    elif ! upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
      warn "Branch '$branch' hat keinen Upstream - Update wird übersprungen."
    else
      remote="${upstream%%/*}"
      fetched=0
      for attempt in 1 2 3; do
        # Beim Systemstart ist das Netzwerk oft noch nicht bereit.
        if git fetch --quiet --prune "$remote" 2>/dev/null; then fetched=1; break; fi
        ((attempt < 3)) && sleep 5
      done

      if ((!fetched)); then
        warn "git fetch fehlgeschlagen (kein Netzwerk?) - es wird nur gestowt."
      elif [[ "$(git rev-parse HEAD)" == "$(git rev-parse "$upstream")" ]]; then
        log "Bereits aktuell ($branch @ $(git rev-parse --short HEAD))."
      elif ((dry_run)); then
        log "[dry-run] würde $(git rev-list --count "HEAD..$upstream") Commit(s) von $upstream übernehmen."
      elif git merge --ff-only --quiet "$upstream" 2>/dev/null; then
        log "Aktualisiert auf $(git rev-parse --short HEAD) ($branch)."
      else
        warn "Kein Fast-Forward auf $upstream möglich - bitte manuell auflösen."
      fi
    fi
  fi
fi

# --- Pakete bestimmen ---------------------------------------------------------

if [[ -n "${DOTFILES_PACKAGES:-}" ]]; then
  read -r -a packages <<<"$DOTFILES_PACKAGES"
else
  packages=()
  shopt -s nullglob
  for dir in */; do
    dir="${dir%/}"
    [[ "$dir" == .* ]] && continue
    # Ein Stow-Paket enthält mindestens einen Dotfile-Eintrag für $HOME.
    if [[ -n "$(find "$dir" -mindepth 1 -maxdepth 1 -name '.*' -print -quit)" ]]; then
      packages+=("$dir")
    fi
  done
  shopt -u nullglob
fi

((${#packages[@]})) || { err "Keine Stow-Pakete in $DOTFILES_DIR gefunden."; exit 1; }

# --- Stow ---------------------------------------------------------------------

status=0
failed=()

for pkg in "${packages[@]}"; do
  if ((dry_run)); then
    log "[dry-run] stow -t $DOTFILES_TARGET -R $pkg"
    ((quiet)) || stow --no --verbose=1 --target="$DOTFILES_TARGET" --restow "$pkg" 2>&1 |
      sed 's/^/[dotfiles-sync]   /'
    continue
  fi

  if output="$(stow --target="$DOTFILES_TARGET" --restow "$pkg" 2>&1)"; then
    log "gestowt: $pkg"
  else
    status=1
    failed+=("$pkg")
    err "stow fehlgeschlagen für '$pkg':"
    printf '%s\n' "$output" | sed 's/^/[dotfiles-sync]   /' >&2
  fi
done

if ((status)); then
  err "Fehlgeschlagene Pakete: ${failed[*]}"
  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "dotfiles-sync" "Stow fehlgeschlagen: ${failed[*]}" || true
  fi
else
  log "Fertig - ${#packages[@]} Paket(e): ${packages[*]}"
fi

exit "$status"
